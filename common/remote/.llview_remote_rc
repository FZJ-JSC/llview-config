# System name
export LLVIEW_SYSTEMNAME="systemname"

# Folder locations
export LLVIEW_HOME="$HOME/llview_package"
export LLVIEW_DATA="$HOME/.data"
export LLVIEW_CONF="$LLVIEW_DATA/llview_jsc_configs/${LLVIEW_SYSTEMNAME}/configs"
# Shared folder between Remote and Server (same as $LLVIEW_SHARED in .llview_server_rc)
export LLVIEW_SHARED="/p/shared/llview/${LLVIEW_SYSTEMNAME^^}/"

# Shutdown signal file
export LLVIEW_SHUTDOWN="$HOME/HALT_ALL"

# How many days logs should be kept (apart from current day)
export LLVIEW_LOG_DAYS=2

# PERL5 definitions
#module load Perl
# module load Perl-bundle-CPAN
export PATH="/p/home/perl5/bin${PATH:+:${PATH}}"
export PERL5LIB="/p/home/perl5/lib/perl5${PERL5LIB:+:${PERL5LIB}}"
export PERL_LOCAL_LIB_ROOT="/p/home/perl5${PERL_LOCAL_LIB_ROOT:+:${PERL_LOCAL_LIB_ROOT}}"
export PERL_MB_OPT="--install_base \"/p/home/perl5\""
export PERL_MM_OPT="INSTALL_BASE=/p/home/perl5"
export LD_LIBRARY_PATH="/p/software/default/stages/2026/software/Perl/5.40.2-GCCcore-14.3.0//lib:$LD_LIBRARY_PATH"
export LIBRARY_PATH="/p/software/default/stages/2026/software/Perl/5.40.2-GCCcore-14.3.0//lib:$LIBRARY_PATH"
export PATH="/p/software/default/stages/2026/software/Perl/5.40.2-GCCcore-14.3.0//bin:$PATH"

# Python definitions
# module load Python
# module load PyYAML
export LD_LIBRARY_PATH="/p/software/default/stages/2026/software/Python/3.13.5-GCCcore-14.3.0/lib:$LD_LIBRARY_PATH"
export LIBRARY_PATH="/p/software/default/stages/2026/software/Python/3.13.5-GCCcore-14.3.0/lib:$LIBRARY_PATH"
export PATH="/p/software/default/stages/2026/software/Python/3.13.5-GCCcore-14.3.0/bin:$PATH"
export PYTHONPATH="/p/software/default/stages/2026/software/Python/3.13.5-GCCcore-14.3.0/easybuild/python:$PYTHONPATH"

